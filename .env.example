# ============================================================================
# AWS Services Integration
# ============================================================================
# Only these two values are needed to enable full AWS services integration.
# All other configuration will be fetched from AWS Parameter Store/Secrets Manager.

AWS_REGION=ap-southeast-2
AWS_USERNAME=n11974796

# ============================================================================
# OPTIONAL LOCAL DEVELOPMENT OVERRIDES
# ============================================================================
# Uncomment any of these to override AWS configuration for local development

# Database configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/unstablefusion

# JWT configuration  
# JWT_SECRET=your-local-jwt-secret

# File storage configuration
# IMAGES_DIR=./generated_images

# Stable Diffusion models configuration
# DEFAULT_MODEL=CompVis/stable-diffusion-v1-4

# Pipeline configuration
# MAX_CONCURRENT=2

# CORS configuration (for devlopment)
# CORS_ORIGINS=*

# Hardcoded users (for local development without Cognito)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# DEMO_USERNAME=demo  
# DEMO_PASSWORD=demoi